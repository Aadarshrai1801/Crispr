# ---- LLM (Groq, OpenAI-compatible) ----
# Get a key at https://console.groq.com/keys
# Model IDs rotate — check GET /openai/v1/models with your key if you hit model_not_found.
# Good current options: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Embeddings (local via transformers.js, no key needed) ----
# First call downloads ~25MB from HuggingFace hub, then cached locally.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# ---- Retrieval / correction layer tuning ----
# Match threshold calibrated for local MiniLM embeddings (legit paraphrases ~0.80-0.86).
# If you switch to a stronger embedding model, consider raising toward 0.87-0.90.
CORRECTION_MATCH_THRESHOLD=0.80
CORRECTION_CONFLICT_THRESHOLD=0.90
RETRIEVAL_TOP_K=6
RETRY_TOP_K=14
MAX_RETRIES=2
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
OCR_MIN_CHARS=32
ENABLE_OCR=1

# ---- Storage ----
DATA_DIR=./data
