# ---- LLM (Groq, OpenAI-compatible) ----
# Get a key at https://console.groq.com/keys
# Model IDs rotate — check GET /openai/v1/models with your key if you hit model_not_found.
# Good current options: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Embeddings (local via transformers.js, no key needed) ----
# First call downloads ~25MB from HuggingFace hub, then cached locally.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# ---- Retrieval / correction layer tuning ----
# Match threshold calibrated for local MiniLM embeddings (legit paraphrases ~0.80-0.86).
# If you switch to a stronger embedding model, consider raising toward 0.87-0.90.
CORRECTION_MATCH_THRESHOLD=0.80
CORRECTION_CONFLICT_THRESHOLD=0.90
RETRIEVAL_TOP_K=6
RETRY_TOP_K=14
MAX_RETRIES=2
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
OCR_MIN_CHARS=32
ENABLE_OCR=1

# ---- Storage ----
# Point this at customer-managed storage for on-prem/VPC deployments (FR-44):
# all documents, embeddings, SQLite metadata and correction data live under this dir.
DATA_DIR=./data

# ---- v2: trust, integrations & compounding intelligence ----
# Default answer-confidence threshold (FR-42); overridable per workspace in Settings.
CONFIDENCE_THRESHOLD=0.55
# Conflict detection tuning (FR-43).
CONFLICT_CANDIDATE_SIMILARITY=0.86
CONFLICT_SCAN_MAX_CHUNKS=1200
# Compounding-intelligence tuning (FR-50/FR-51).
CROSS_DOC_SUGGESTION_SIMILARITY=0.72
REPEATED_FLAG_CLUSTER_SIZE=3
REPEATED_FLAG_CLUSTER_SIMILARITY=0.82
# Secret used to encrypt integration credentials at rest (AES-256-GCM). SET THIS IN PRODUCTION.
CRISPR_ENCRYPTION_SECRET=
# Webhook delivery timeout (ms). Payloads are HMAC-SHA256 signed per endpoint.
WEBHOOK_TIMEOUT_MS=5000
# Slack bot (FR-45): point a /crisp slash command at /api/integrations/slack/events
SLACK_DEFAULT_WORKSPACE_ID=ws_default
SLACK_SIGNING_SECRET=

